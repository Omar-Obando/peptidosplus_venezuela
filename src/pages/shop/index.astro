---
/**
 * Shop / Catálogo — diseño de marca del sitio original (store.html)
 * con datos WooCommerce headless (29 productos, imágenes, precios $).
 *
 * Elementos del original: banner verde "3 productos nuevos", chips de
 * categorías, buscador, tarjetas bg-neutral-100 rounded-[24px] con
 * pp-coa-pill en-tarjeta y botones "Ver detalles"/"Añadir". Datos del CMS.
 */
import BrandLayout from '@/layouts/BrandLayout.astro';
import { getLocalProducts, getLocalVisibleCategories } from '../../lib/local-product-data';
import { formatPrice, isInStock } from '../../lib/woocommerce';
import { getPublicProductImageUrl } from '../../lib/product-media';

export const prerender = true;

const products = await getLocalProducts();
const categories = await getLocalVisibleCategories();

const items = products.map((p: any) => {
  const img = getPublicProductImageUrl(p.images?.[0]?.src || '', p.slug, p.name) || '';
  const inStock = isInStock(p);
  const price = formatPrice(p);
  return {
    id: p.id,
    slug: p.slug,
    name: p.name,
    sub: (p.short_description || '').replace(/<[^>]*>/g, ''),
    price,
    img,
    inStock,
    catSlug: p.categories?.[0]?.slug || '',
  };
});

const categoryChips = categories.filter((c: any) => c.parent === 0 && c.count > 0);

const title = 'Catálogo de péptidos de investigación | Peptidos Plus';
const description = 'Péptidos de investigación con certificado de análisis en cada lote. Catálogo completo de Peptidos Plus Venezuela.';
---

<BrandLayout title={title} rawTitle={title} description={description} canonicalUrl={`/shop`}>
  <main id="main-content">
    <!-- Banner "3 productos nuevos" (marca original) -->
    <div class="relative isolate w-full overflow-hidden border-b-2 border-[#E9C46A] bg-gradient-to-r from-[#0B5B45] via-[#16A672] to-[#0B5B45] text-white shadow-[inset_0_1px_0_rgba(255,255,255,0.12)]">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 [background:radial-gradient(60%_120%_at_50%_-20%,rgba(255,255,255,0.18),transparent)]"></div>
      <div class="relative mx-auto flex max-w-[1500px] items-center justify-center gap-3 px-4 py-2.5 text-center text-sm sm:text-[15px]">
        <span aria-hidden="true">✨</span>
        <p><b>3 productos nuevos</b><span aria-hidden="true"> ● </span>Lemon Bottle, Cagrilintida y Kisspeptin</p>
        <a href="/shop" class="ml-2 inline-flex items-center gap-1 rounded-full bg-white/15 px-3 py-1 text-xs font-semibold hover:bg-white/25 transition-colors">Ver productos
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
      </div>
    </div>

    <!-- Header del catálogo -->
    <section class="py-8 lg:py-12 bg-white">
      <div class="content-container">
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4 mb-8">
          <div>
            <p class="pp-cejilla font-poppins">Catálogo · Peptidos Plus</p>
            <h1 class="pp-h2 mb-2">Catálogo de investigación</h1>
            <p class="text-gray-500 text-sm lg:text-base">Compuestos con certificado de análisis en cada lote.</p>
          </div>
          <div data-pp-cuenta class="text-sm text-gray-500"><b>{items.length}</b> productos</div>
        </div>

        <!-- Categorías / chips -->
        <div class="flex flex-wrap gap-2 mb-6" data-testid="category-chips">
          <button type="button" data-pp-cat="" class="px-4 py-2 rounded-full text-sm font-medium bg-brand-black text-white transition-colors cursor-pointer">Todos</button>
          {categoryChips.map((c: any) => (
            <button type="button" data-pp-cat={c.slug} class="px-4 py-2 rounded-full text-sm font-medium bg-neutral-100 text-black/70 border border-black/10 hover:border-black hover:text-black transition-colors cursor-pointer">{c.name}</button>
          ))}
        </div>

        <!-- Buscador -->
        <div class="relative max-w-md mb-8">
          <input type="search" placeholder="Buscar péptido..." data-pp-busca aria-label="Buscar péptido" class="w-full pl-11 pr-4 py-3 rounded-full border border-black/15 bg-white text-sm focus:outline-none focus:border-black transition-colors" />
          <svg class="w-4 h-4 text-gray-400 absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.35-4.35"></path></svg>
        </div>
      </div>
    </section>

    <!-- Grid de productos (diseño original) -->
    <section class="pb-16 lg:pb-20 bg-white">
      <div class="content-container">
        <div data-testid="products-list" class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4 lg:gap-6">
          {items.map((p) => (
            <article class="group h-full" data-pp-nombre={p.name.toLowerCase()} data-pp-cat={p.catSlug}>
              <div class="bg-neutral-100 rounded-[20px] lg:rounded-[24px] overflow-hidden h-full flex flex-col border border-black/[0.08] transition-shadow duration-200 hover:shadow-[0_14px_32px_-14px_rgba(19,19,21,0.22)]">
                <div class="relative aspect-[4/5] overflow-hidden">
                  <a class="block absolute inset-0" href={`/shop/product/${p.slug}`}>
                    <img alt={p.name} loading="lazy" decoding="async" class="object-cover object-[80%_center] transition-transform duration-300 group-hover:scale-105" sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw" src={p.img} />
                  </a>
                  {p.inStock ? (
                    <a class="pp-coa-pill en-tarjeta" data-pp-coa-abrir={p.slug} href={`/shop/product/${p.slug}#coa`} aria-label={`Ver el certificado de análisis de ${p.name}`}><i aria-hidden="true"></i>Certificado</a>
                  ) : (
                    <span class="absolute top-3 left-3 text-xs font-medium bg-black/70 text-white px-3 py-1.5 rounded-full">Agotado</span>
                  )}
                </div>
                <div class="p-3 lg:p-4 flex flex-col flex-grow bg-white border-t border-black/[0.05] rounded-b-[20px] lg:rounded-b-[24px]">
                  <a class="hover:opacity-80 transition-opacity min-w-0" href={`/shop/product/${p.slug}`}>
                    <h3 class="font-semibold text-[15px] lg:text-lg text-brand-black leading-tight line-clamp-1">{p.name}</h3>
                    <p class="text-gray-500 text-[11px] lg:text-xs mt-0.5 line-clamp-1">{p.sub}</p>
                  </a>
                  <div class="mt-1.5 flex items-baseline gap-1.5 flex-wrap">
                    <span class="text-gray-500 text-[10px] lg:text-xs">Desde</span>
                    <span class="font-poppins font-semibold text-[17px] lg:text-xl text-brand-black leading-tight">{p.price}</span>
                  </div>
                  <div class="mt-auto pt-2.5 flex gap-1.5">
                    <a href={`/shop/product/${p.slug}`} class="flex-1 h-9 lg:h-10 rounded-full border border-black/15 text-xs lg:text-sm font-medium text-black/70 hover:border-black hover:text-black transition-colors flex items-center justify-center">Ver detalles</a>
                    {p.inStock && (
                      <a href={`/shop/product/${p.slug}`} class="w-full h-9 lg:h-10 px-3 rounded-full font-medium text-xs lg:text-sm leading-none flex items-center justify-center gap-1.5 transition-colors bg-brand-black text-white hover:bg-gray-800" aria-label={`Añadir ${p.name} al carrito`}>
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2 4h14"></path><circle cx="9" cy="20" r="1"></circle><circle cx="18" cy="20" r="1"></circle></svg>
                        Añadir
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
        <p data-pp-vacio class="hidden text-center text-gray-500 py-16">No encontramos péptidos que coincidan con tu búsqueda.</p>
      </div>
    </section>
  </main>
</BrandLayout>

<script>
  // Filtros/búsqueda del catálogo (comportamiento original, cliente).
  document.addEventListener('DOMContentLoaded', () => {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-pp-nombre]'));
    const chips = Array.from(document.querySelectorAll<HTMLElement>('[data-pp-cat]'));
    const busca = document.querySelector('[data-pp-busca]') as HTMLInputElement | null;
    const cuenta = document.querySelector('[data-pp-cuenta]');
    const vacio = document.querySelector('[data-pp-vacio]');
    let cat = '';

    function apply() {
      const q = (busca?.value || '').trim().toLowerCase();
      let vis = 0;
      cards.forEach((el) => {
        const okCat = !cat || el.dataset.ppCat === cat;
        const okQ = !q || (el.dataset.ppNombre || '').includes(q);
        const show = okCat && okQ;
        el.style.display = show ? '' : 'none';
        if (show) vis++;
      });
      if (cuenta) cuenta.innerHTML = `<b>${vis}</b> productos`;
      if (vacio) vacio.classList.toggle('hidden', vis !== 0);
    }

    chips.forEach((ch) => {
      ch.addEventListener('click', () => {
        cat = ch.dataset.ppCat || '';
        chips.forEach((o) => {
          const a = o === ch;
          o.className = a
            ? 'px-4 py-2 rounded-full text-sm font-medium bg-brand-black text-white transition-colors cursor-pointer'
            : 'px-4 py-2 rounded-full text-sm font-medium bg-neutral-100 text-black/70 border border-black/10 hover:border-black hover:text-black transition-colors cursor-pointer';
        });
        apply();
      });
    });

    busca?.addEventListener('input', apply);
    apply();
  });
</script>
