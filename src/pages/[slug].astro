---
/**
 * Friendly URL — /{slug} → sirve el HTML estático correspondiente:
 *   - productos: public/producto-{slug}.html
 *   - páginas internas: public/{slug}.html (certificados, privacidad, terminos,
 *     uso-investigacion, contacto, checkout, carrito)
 * (SSR on-demand; el Worker renderiza esta página, no depende de ASSETS).
 *
 * Fuera de los slugs conocidos → 404.
 */
export const prerender = false;

const PRODUCT_SLUGS = new Set<string>([
  'agua-bacteriostatica', 'agua-bacteriostatica-hospira', 'cagrilintida',
  'cjc-1295-ipamorelin', 'cjc-1295-sin-dac', 'dsip', 'epitalon', 'ghk-cu',
  'glow', 'glutation', 'ipamorelin', 'kisspeptin-10', 'klow', 'kpv',
  'lemon-bottle', 'melanotan-2', 'mots-c', 'nad', 'pt-141', 'retatrutida',
  'selank', 'semaglutida', 'semax', 'sermorelin', 'ss-31-elamipretide',
  'tesamorelin', 'thymosin-alpha-1', 'tirzepatida', 'wolverine-bpc-157-tb-500',
]);

// Páginas internas que se sirven limpias en /{slug} (sin .html)
const INTERNAL_PAGES = new Set([
  'certificados', 'privacidad', 'terminos', 'uso-investigacion', 'contacto',
  'checkout', 'carrito',
]);

const PRODUCT_HTML: Record<string, string> = import.meta.glob('../../public/producto-*.html', {
  query: '?raw', import: 'default', eager: true,
}) as Record<string, string>;
const PAGE_HTML: Record<string, string> = import.meta.glob('../../public/*.html', {
  query: '?raw', import: 'default', eager: true,
}) as Record<string, string>;

const SITE_URL = 'https://ve.peptidosplus.com';

function sanitizeCanonical(html: string, canonical: string): string {
  let out = html;
  if (/rel="canonical"/i.test(out)) {
    out = out.replace(/<link rel="canonical"[^>]*>/i, `<link rel="canonical" href="${canonical}" />`);
  } else if (/<\/head>/i.test(out)) {
    out = out.replace(/<\/head>/i, `<link rel="canonical" href="${canonical}" />\n</head>`);
  }
  return out;
}

const { slug } = Astro.params;
if (!slug) return new Response('Not Found', { status: 404 });

if (PRODUCT_SLUGS.has(slug)) {
  const key = Object.keys(PRODUCT_HTML).find(
    (k) =>
      k.endsWith(`/producto-${slug}.html`) ||
      (slug.endsWith('-elamipretide') && k.endsWith(`/producto-${slug.replace(/-elamipretide$/, '')}.html`))
  );
  const html = key ? (PRODUCT_HTML[key] as string) : null;
  if (!html) return new Response('Not Found', { status: 404 });
  return new Response(sanitizeCanonical(html, `${SITE_URL}/${slug}`), {
    headers: { 'Content-Type': 'text/html; charset=utf-8' },
  });
}

if (INTERNAL_PAGES.has(slug)) {
  const key = Object.keys(PAGE_HTML).find((k) => k.endsWith(`/${slug}.html`));
  const html = key ? (PAGE_HTML[key] as string) : null;
  if (!html) return new Response('Not Found', { status: 404 });
  return new Response(sanitizeCanonical(html, `${SITE_URL}/${slug}`), {
    headers: { 'Content-Type': 'text/html; charset=utf-8' },
  });
}

// Fuera de los slugs conocidos: a la página 404 del sitio (cabecera, pie, estilos), como antes de servir las páginas
// internas por aquí. Un «Not Found» en texto plano dejaba al visitante en una página en blanco (2026-09-29).
// (Astro.rewrite('/404') no sirve: 404.astro está pre-renderizada y el worker no tiene su componente → error 500.)
return Astro.redirect('/404');
---
