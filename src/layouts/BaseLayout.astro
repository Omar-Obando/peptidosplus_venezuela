---
/**
 * BaseLayout — shell de marca Peptidos Plus.
 *
 * Aplica el CSS compilado + header/footer/menú móvil del sitio original
 * (navy #0a192f, Anek/Poppins/Roboto). Todas las páginas (tienda, cuenta,
 * blog, legales) necesitan este layout para verse con la marca correcta.
 * La capa de datos (WordPress/WooCommerce) sigue viniendo del template.
 */
import BrandLayout from './BrandLayout.astro';

interface Props {
  title: string;
  rawTitle?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  robots?: string[];
  openGraph?: Record<string, any>;
  twitter?: Record<string, any>;
}

const {
  title,
  rawTitle,
  description,
  image,
  canonicalUrl,
  robots,
  openGraph,
  twitter,
} = Astro.props;
---

<BrandLayout
  title={title}
  rawTitle={rawTitle}
  description={description}
  image={image}
  canonicalUrl={canonicalUrl}
  robots={robots}
  openGraph={openGraph}
  twitter={twitter}
>
  <slot name="head" />
  <slot />
  <slot name="footer" />
</BrandLayout>
