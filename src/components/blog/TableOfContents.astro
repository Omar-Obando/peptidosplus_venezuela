---
/**
 * TableOfContents — índice de contenidos de un artículo.
 *
 * Props:
 *  - headings: TocHeading[] ({ level, text, id })
 *  - readingTime?: number
 */
import type { TocHeading } from '@/lib/seo';

interface Props {
  headings: TocHeading[];
  readingTime?: number;
}

const { headings = [], readingTime } = Astro.props;

const visible = headings.filter((h) => h.level <= 3);
if (visible.length === 0) {
  return;
}
---
<nav aria-label="Índice de contenidos" class="mb-10 rounded-2xl border border-outline bg-surface-alt/60 p-6">
  <div class="flex items-center justify-between mb-4">
    <span class="text-sm font-bold uppercase tracking-wider text-content">Índice de contenidos</span>
    {readingTime && <span class="text-xs text-content-light">{readingTime} min de lectura</span>}
  </div>
  <ol class="space-y-2">
    {visible.map((h, i) => (
      <li>
        <a
          href={`#${h.id}`}
          class:list={[
            'flex items-baseline gap-3 text-sm text-content-light hover:text-primary transition-colors',
            h.level === 3 ? 'pl-5' : '',
          ]}
        >
          <span class="text-xs font-mono text-primary/60 w-5 flex-shrink-0">{i + 1}</span>
          <span>{h.text}</span>
        </a>
      </li>
    ))}
  </ol>
</nav>
