---
/**
 * Tag archive — /tag/[slug] (SSR on-demand, diseño de marca).
 */
import BrandLayout from '@/layouts/BrandLayout.astro';
import { postTitle, postExcerpt, catName, esDate, readTime } from '@/lib/blog';
import { getTagBySlug, getPostsByTag } from '@/lib/wordpress';
import { SITE } from '@/lib/site';

const { slug } = Astro.params;

if (!slug) return Astro.redirect('/404');

let tag: any = null;
try { tag = await getTagBySlug(slug); } catch { tag = null; }

let posts: any[] = [];
try { posts = await getPostsByTag(slug); } catch { posts = []; }

const title = tag?.name || 'Etiqueta';
const description = `Artículos etiquetados como "${title}" en el blog de ${SITE.name}.`;
const canonicalUrl = `${SITE.url}/tag/${slug}`;

const pageLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  url: canonicalUrl,
  description,
  isPartOf: { '@type': 'Blog', url: `${SITE.url}/blog` },
};
---

<BrandLayout title={title} description={description} canonicalUrl={canonicalUrl}>
  <slot name="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(pageLd)} />
  </slot>

  <div class="content-container pp-art-wrap py-12 md:py-16">
    <header class="pg-art-cab mb-10">
      <p class="pg-cejilla font-poppins">Etiqueta</p>
      <h1 class="pg-h1">#{title}</h1>
      <p class="pg-sub">{description}</p>
    </header>

    {posts.length === 0 ? (
      <p class="pg-gris">Aún no hay artículos con esta etiqueta.</p>
    ) : (
      <div class="pg-lista">
        {posts.map((p) => (
          <a class="pg-entrada" href={`/blog/${p.slug}`} data-cat={catName(p)}>
            <span class="pg-entrada-meta"><b class="font-poppins">{catName(p)}</b><span>{esDate(p.date)} · {readTime(p)} min</span></span>
            <h3>{postTitle(p)}</h3>
            <p>{postExcerpt(p, 150)}</p>
          </a>
        ))}
      </div>
    )}
  </div>
</BrandLayout>
