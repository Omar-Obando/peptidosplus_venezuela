---
/**
 * Home — diseño de marca de Peptidos Plus (navy).
 * Secciones y clases reales del sitio original (hero v3, marquee,
 * "Productos destacados", calidad). Datos de productos del CMS.
 */
import BrandLayout from '@/layouts/BrandLayout.astro';
import { SITE } from '@/lib/site';
import { getLocalProducts } from '@/lib/local-product-data';
import { formatStorePrice } from '@/config/store';

export const prerender = true;

let products: any[] = [];
try {
  products = await getLocalProducts();
} catch {
  products = [];
}
const featured = products.slice(0, 6);

const title = 'Peptidos Plus — Péptidos de investigación en Venezuela';
const description =
  'Péptidos de investigación con certificado de análisis público en cada lote, emitido por laboratorio independiente. Kit de aplicación incluido y envíos a toda Venezuela por MRW/Zoom.';
---

<BrandLayout
  title={title}
  rawTitle={title}
  description={description}
  canonicalUrl={`${SITE.url}/`}
>
  <slot name="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: SITE.name,
      url: SITE.url,
      description,
    })} />
  </slot>

  <!-- ===================== HERO v3 (marca) ===================== -->
  <section class="pp-hero-v3" aria-label="Peptidos Plus — péptidos de investigación en Venezuela">
    <canvas class="pp-hero-particulas" aria-hidden="true"></canvas>
    <div class="pp-sec-inner pp-hero-v3-grid">
      <div class="pp-hero-v3-text">
        <h1 class="pp-hero-v3-title">Péptidos y compuestos de investigación <em>en Venezuela.</em></h1>
        <p class="pp-hero-v3-tagline">Compuestos de grado investigación con certificado de análisis en cada lote. Pureza garantizada por encima del 98 %.</p>
        <div class="pp-hero-v3-cta">
          <a href="/shop" class="pp-hero-btn pp-hero-btn-primario">Ver catálogo<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a href="/certificados" class="pp-hero-v3-enlace">Ver los certificados<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        </div>
      </div>
      <div class="pp-hero-v3-vials" aria-hidden="true">
        <div class="pp-vial pp-vial-left"><img decoding="async" sizes="(max-width: 767px) 34vw, 200px" srcset="/assets/viales-ficha/chico/Retatrutida-10mg.webp 400w, /assets/viales-ficha/mini/Retatrutida-10mg.webp 640w, /assets/viales-ficha/Retatrutida-10mg.webp 1002w" src="/assets/viales-ficha/Retatrutida-10mg.webp" alt="" width="1002" height="1959" loading="eager" /></div>
        <div class="pp-vial pp-vial-center"><img decoding="async" sizes="(max-width: 767px) 34vw, 200px" srcset="/assets/viales-ficha/chico/Tirzepatida-10mg.webp 400w, /assets/viales-ficha/mini/Tirzepatida-10mg.webp 640w, /assets/viales-ficha/Tirzepatida-10mg.webp 1002w" src="/assets/viales-ficha/Tirzepatida-10mg.webp" alt="" width="1002" height="1959" loading="eager" /></div>
        <div class="pp-vial pp-vial-right"><img decoding="async" sizes="(max-width: 767px) 34vw, 200px" srcset="/assets/viales-ficha/chico/Glow-70mg.webp 400w, /assets/viales-ficha/mini/Glow-70mg.webp 640w, /assets/viales-ficha/Glow-70mg.webp 1002w" src="/assets/viales-ficha/Glow-70mg.webp" alt="" width="1002" height="1959" loading="eager" /></div>
      </div>
    </div>
  </section>

  <!-- ===================== MARQUEE (marca) ===================== -->
  <div class="pp-marquee" aria-hidden="true">
    <div class="pp-marquee-track">
      <div class="pp-marquee-grupo">
        <span class="pp-marquee-item"><span class="pp-marquee-ic">✓</span><span class="pp-marquee-txt">Certificado en cada lote</span></span>
        <span class="pp-marquee-item"><span class="pp-marquee-ic">✓</span><span class="pp-marquee-txt">Pureza HPLC ≥ 98 %</span></span>
        <span class="pp-marquee-item"><span class="pp-marquee-ic">✓</span><span class="pp-marquee-txt">Kit de aplicación incluido</span></span>
        <span class="pp-marquee-item"><span class="pp-marquee-ic">✓</span><span class="pp-marquee-txt">Envíos a toda Venezuela</span></span>
        <span class="pp-marquee-item"><span class="pp-marquee-ic">✓</span><span class="pp-marquee-txt">Laboratorio independiente</span></span>
      </div>
      <div class="pp-marquee-grupo">
        <span class="pp-marquee-item"><span class="pp-marquee-ic">✓</span><span class="pp-marquee-txt">Certificado en cada lote</span></span>
        <span class="pp-marquee-item"><span class="pp-marquee-ic">✓</span><span class="pp-marquee-txt">Pureza HPLC ≥ 98 %</span></span>
        <span class="pp-marquee-item"><span class="pp-marquee-ic">✓</span><span class="pp-marquee-txt">Kit de aplicación incluido</span></span>
        <span class="pp-marquee-item"><span class="pp-marquee-ic">✓</span><span class="pp-marquee-txt">Envíos a toda Venezuela</span></span>
        <span class="pp-marquee-item"><span class="pp-marquee-ic">✓</span><span class="pp-marquee-txt">Laboratorio independiente</span></span>
      </div>
    </div>
  </div>

  <!-- ===================== PRODUCTOS DESTACADOS (marca) ===================== -->
  {featured.length > 0 && (
    <section class="py-12 w-full max-w-[100vw] overflow-x-hidden">
      <div class="content-container">
        <div class="flex items-end justify-between gap-6 mb-6 lg:mb-8">
          <div>
            <h2 class="font-semibold text-2xl sm:text-3xl lg:text-4xl text-brand-black leading-tight mb-1">Productos destacados</h2>
            <p class="text-gray-500 text-sm lg:text-base">Compuestos con certificado de análisis en cada lote.</p>
          </div>
          <a href="/shop" class="shrink-0 inline-flex items-center gap-1.5 text-sm lg:text-base font-medium text-brand-black hover:opacity-70 transition-opacity">Ver todos<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg></a>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 lg:gap-6">
          {featured.map((p) => (
            <a class="group h-full" href={`/shop/${p.slug}`} data-testid="product-wrapper">
              <div class="bg-neutral-100 rounded-[20px] lg:rounded-[24px] overflow-hidden h-full flex flex-col border border-black/[0.08] transition-shadow duration-200 hover:shadow-[0_14px_32px_-14px_rgba(19,19,21,0.22)]">
                <div class="relative aspect-[4/5] overflow-hidden">
                  <img alt={p.name} loading="lazy" decoding="async" class="object-cover object-[80%_center] transition-transform duration-300 group-hover:scale-105" sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw" src={p.images?.[0]?.src || '/assets/img/landing/QuickCards/Boxes.webp'} />
                  <span class="pp-coa-pill en-tarjeta" aria-label={`Ver el certificado de análisis de ${p.name}`}><i aria-hidden="true"></i>Certificado</span>
                </div>
                <div class="p-3 lg:p-4 flex flex-col flex-grow bg-white border-t border-black/[0.05] rounded-b-[20px] lg:rounded-b-[24px]">
                  <h3 class="font-semibold text-[15px] lg:text-lg text-brand-black leading-tight line-clamp-1">{p.name}</h3>
                  <p class="text-gray-500 text-[11px] lg:text-xs mt-0.5 line-clamp-1">{p.short_description?.replace(/<[^>]*>/g, '') || 'Péptido de investigación'}</p>
                  <div class="mt-1.5 flex items-baseline gap-1.5 flex-wrap">
                    <span class="text-gray-500 text-[10px] lg:text-xs">Desde</span>
                    <span class="font-poppins font-semibold text-[17px] lg:text-xl text-brand-black leading-tight">{formatStorePrice(Number(p.price || 0))}</span>
                  </div>
                  <div class="mt-auto pt-2.5 flex gap-1.5">
                    <span class="flex-1 h-9 lg:h-10 rounded-full border border-black/15 text-xs lg:text-sm font-medium text-black/70 hover:border-black hover:text-black transition-colors flex items-center justify-center">Ver detalles</span>
                  </div>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ===================== CALIDAD / CERTIFICADO (marca) ===================== -->
  <section class="py-8 lg:py-12 bg-white">
    <div class="content-container grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14 items-center">
      <div>
        <h2 class="text-xl md:text-2xl lg:text-3xl font-semibold text-black leading-[1.05] mb-2">Calidad garantizada</h2>
        <p class="text-gray-500 leading-relaxed mb-6">No reutilizamos certificados: cada lote nuevo se analiza (HPLC) y se publica. El certificado de tu vial es el de su lote, verificable en el portal del laboratorio independiente.</p>
        <a href="/certificados" class="inline-flex items-center gap-2.5 bg-brand-black text-white text-sm lg:text-base font-medium px-6 lg:px-7 h-11 lg:h-12 rounded-full hover:bg-gray-800 hover:shadow-lg hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 leading-none">Ver certificados<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg></a>
      </div>
      <div class="pp-calidad-viales relative z-10" aria-hidden="false">
        <img alt="Vial de Tesamorelin 10 mg de Peptidos Plus" loading="lazy" width="320" height="450" decoding="async" class="pp-cv-lado pp-cv-izq" src="/assets/viales-ficha/Tesamorelin-10mg.webp" />
        <img alt="Vial de Retatrutida de Peptidos Plus" loading="lazy" width="320" height="450" decoding="async" class="pp-cv-centro" src="/assets/viales-ficha/Retatrutida-10mg.webp" />
        <img alt="Vial de Tirzepatida de Peptidos Plus" loading="lazy" width="320" height="450" decoding="async" class="pp-cv-lado pp-cv-der" src="/assets/viales-ficha/Tirzepatida-10mg.webp" />
      </div>
    </div>
  </section>
</BrandLayout>
