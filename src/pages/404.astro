---
/**
 * 404 — página no encontrada, con el diseño de las páginas interiores (las mismas
 * clases pg-* de términos, privacidad y artículos: letra, colores y tarjetas).
 * Sin clases de la plantilla: en producción solo cargan las hojas de /assets/css/.
 */
import BrandLayout from '@/layouts/BrandLayout.astro';

export const prerender = true;
---

<BrandLayout
  title="Página no encontrada"
  description="La página que buscas no existe o cambió de dirección."
  robots={['noindex', 'follow']}
>
  <div class="pg" id="pg-legal-404">
    <article class="pg-art">
      <header class="pg-art-cab">
        <p class="pg-cejilla">Error 404</p>
        <h1 class="pg-h1">No encontramos esta página</h1>
        <p class="pg-sub">Puede que el enlace esté mal escrito o que la página ya no exista. Desde aquí puedes volver al inicio o ir al catálogo.</p>
      </header>
      <nav class="pg-art-nav" aria-label="Seguir navegando">
        <a href="/"><small>Volver</small><b>Al inicio</b></a>
        <a class="der" href="/tienda"><small>Ver</small><b>El catálogo de péptidos</b></a>
      </nav>
    </article>
  </div>
</BrandLayout>
