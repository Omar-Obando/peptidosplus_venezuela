---
/**
 * BrandLayout — layout global con el diseño de marca de Peptidos Plus
 * (navy #0a192f, fuentes Anek/Poppins/Roboto, clases pp- y pg-).
 *
 * El CSS compilado vive en /assets/css/ (copiado del sitio original:
 * 44599e2480b4e9b7-080b9ca3.css, remix-tokens.css, 1a78e74ce72d3608-19ad952d
 * .tokenized.css, 8fd2756b064cd018.css, 18b678a1602d6429-41fbeeff.css,
 * marca-navy.css). El header/footer/menú móvil son el markup real del sitio
 * original, adaptado a las rutas de la app (/, /shop, /blog, /certificados,
 * /contacto, /faq).
 */
import { SITE } from '@/lib/site';

interface Props {
  title: string;
  rawTitle?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  robots?: string[];
  openGraph?: { title?: string; description?: string; image?: string; type?: string };
  twitter?: { title?: string; description?: string; image?: string; card?: string };
}

const {
  title,
  rawTitle,
  description = 'Péptidos de investigación con certificado de análisis público en cada lote.',
  image,
  canonicalUrl,
  robots = ['index', 'follow'],
  openGraph,
  twitter,
} = Astro.props;

const fullTitle = rawTitle || `${title} — ${SITE.name}`;
const ogTitle = openGraph?.title || fullTitle;
const ogDescription = openGraph?.description || description;
const ogImage = openGraph?.image || image || '/assets/img/og-peptidos-plus.jpg';
const twitterCard = twitter?.card || 'summary_large_image';

const canonical = canonicalUrl && /^https?:\/\//.test(canonicalUrl)
  ? canonicalUrl
  : `${SITE.url}${canonicalUrl || Astro.url.pathname}`;

const robotsContent = robots.length ? robots.join(', ') : 'index, follow';
---

<!doctype html>
<html lang="es" data-mode="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Peptidos Plus" />
    <meta name="creator" content="Peptidos Plus" />
    <meta name="publisher" content="Peptidos Plus" />
    <meta name="robots" content={robotsContent} />
    <meta name="format-detection" content="telephone=no, address=no, email=no" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/marca/peptidosplus-isotipo-navy.svg" type="image/svg+xml" />

    <!-- Marca: CSS compilado del sitio original (navy, fuentes, pp-*/pg-*) -->
    <link rel="stylesheet" href="/assets/css/44599e2480b4e9b7-080b9ca3.css" />
    <link rel="stylesheet" href="/assets/css/remix-tokens.css" />
    <link rel="stylesheet" href="/assets/css/1a78e74ce72d3608-19ad952d.tokenized.css" />
    <link rel="stylesheet" href="/assets/css/8fd2756b064cd018.css" />
    <link rel="stylesheet" href="/assets/css/18b678a1602d6429-41fbeeff.css" />
    <link rel="stylesheet" href="/assets/css/marca-navy.css" />
    <!-- Tokens del template (text-primary, bg-surface, etc. para tienda/cuenta) -->
    <link rel="stylesheet" href="/assets/css/template-theme.css" />

    <!-- Open Graph -->
    <meta property="og:type" content={openGraph?.type || 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="es_VE" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:site" content="@peptidosplus" />
    <meta name="twitter:creator" content="@peptidosplus" />
    <meta name="twitter:title" content={openGraph?.title || fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={twitter?.image || ogImage} />

    <slot name="head" />
  </head>

  <style is:global>
    /* Reveal-on-scroll: paired with public/behaviors.js (IntersectionObserver
       adds .is-visible). Global because markers live in slotted page markup. */
    .reveal,
    [data-reveal],
    [class*="animate-fade"],
    [class*="animate-slide"] {
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
      will-change: opacity, transform;
    }
    .reveal.is-visible,
    [data-reveal].is-visible,
    [class*="animate-fade"].is-visible,
    [class*="animate-slide"].is-visible {
      opacity: 1;
      transform: translateY(0);
    }
    @media (prefers-reduced-motion: reduce) {
      .reveal, [data-reveal], [class*="animate-fade"], [class*="animate-slide"] {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
    }
  </style>

  <body class="font-poppins antialiased">
