---
/**
 * BrandLayout — layout global con el diseño de marca de Peptidos Plus
 * (el de la portada: navy #0a192f, Hanken Grotesk + JetBrains Mono).
 *
 * El CSS vive en /assets/css/: 1a78e74ce72d3608-19ad952d.tokenized.css
 * (utilidades), pp-tokens.css, marca-navy.css, template-theme.css y
 * pp-sitio.css (letras, cabecera y pie). La cabecera, el pie y el botón
 * flotante son los mismos de la portada y de las páginas estáticas.
 */
import { SITE } from '@/lib/site';
import GeoCountryBanner from '@/components/GeoCountryBanner.astro';
// Cabecera, pie y botón flotante compartidos con todo el sitio: salen de la portada
// (public/index.html) y se copian a src/cromo/ con cromo-sitio.js. No editar aquí.
import cabecera from '../cromo/cabecera.html?raw';
import pie from '../cromo/pie.html?raw';
import flotante from '../cromo/flotante.html?raw';

interface Props {
  title: string;
  rawTitle?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  robots?: string[];
  openGraph?: { title?: string; description?: string; image?: string; type?: string };
  twitter?: { title?: string; description?: string; image?: string; card?: string };
}

const {
  title,
  rawTitle,
  description = 'Péptidos de investigación con certificado de análisis público en cada lote.',
  image,
  canonicalUrl,
  robots = ['index', 'follow'],
  openGraph,
  twitter,
} = Astro.props;

const fullTitle = rawTitle || (title && (title.includes(SITE.name) || /- Site Title/i.test(title)) ? title : `${title} — ${SITE.name}`);
const ogTitle = openGraph?.title || fullTitle;
const ogDescription = openGraph?.description || description;
const ogImage = openGraph?.image || image || '/assets/img/og-peptidos-plus.jpg';
const twitterCard = twitter?.card || 'summary_large_image';

const canonical = canonicalUrl && /^https?:\/\//.test(canonicalUrl)
  ? canonicalUrl
  : `${SITE.url}${canonicalUrl || Astro.url.pathname}`;

const robotsContent = robots.length ? robots.join(', ') : 'index, follow';

// Geo-detect: Cloudflare injects CF-IPCountry on the Worker edge (e.g. "NI", "VE").
const detectCountry = Astro.request.headers.get('CF-IPCountry') || '';
---

<!doctype html>
<html lang="es" data-mode="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Peptidos Plus" />
    <meta name="creator" content="Peptidos Plus" />
    <meta name="publisher" content="Peptidos Plus" />
    <meta name="robots" content={robotsContent} />
    <meta name="format-detection" content="telephone=no, address=no, email=no" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/marca/peptidosplus-isotipo-navy.svg" type="image/svg+xml" />

    <!-- Marca: tokens, utilidades compiladas y capa navy (las mismas hojas de las páginas estáticas) -->
    <link rel="stylesheet" href="/assets/css/pp-tokens.css" />
    <link rel="stylesheet" href="/assets/css/1a78e74ce72d3608-19ad952d.tokenized.css" />
    <link rel="stylesheet" href="/assets/css/marca-navy.css" />
    <!-- Tokens del template (text-primary, bg-surface, etc. para tienda/cuenta) -->
    <link rel="stylesheet" href="/assets/css/template-theme.css" />
    <link rel="preload" href="/assets/fonts/hanken-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/assets/css/pp-sitio.css" />

    <!-- Open Graph -->
    <meta property="og:type" content={openGraph?.type || 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="es_VE" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:site" content="@peptidosplus" />
    <meta name="twitter:creator" content="@peptidosplus" />
    <meta name="twitter:title" content={openGraph?.title || fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={twitter?.image || ogImage} />

    <slot name="head" />
  </head>

  <style is:global>
    /* Letras de marca: el CSS compilado usa var(--font-poppins)/var(--font-anek)/
       var(--font-roboto). Todas apuntan a Hanken Grotesk, la letra del diseño
       nuevo (pp-sitio.css hace lo mismo en el body). */
    :root {
      --font-poppins: "Hanken Grotesk", system-ui, sans-serif;
      --font-anek: "Hanken Grotesk", system-ui, sans-serif;
      --font-roboto: "Hanken Grotesk", system-ui, sans-serif;
    }

    /* Reveal-on-scroll: paired with public/behaviors.js (IntersectionObserver
       adds .is-visible). Global because markers live in slotted page markup. */
    .reveal,
    [data-reveal],
    [class*="animate-fade"],
    [class*="animate-slide"] {
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
      will-change: opacity, transform;
    }
    .reveal.is-visible,
    [data-reveal].is-visible,
    [class*="animate-fade"].is-visible,
    [class*="animate-slide"].is-visible {
      opacity: 1;
      transform: translateY(0);
    }
    @media (prefers-reduced-motion: reduce) {
      .reveal, [data-reveal], [class*="animate-fade"], [class*="animate-slide"] {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
    }
  </style>

  <body class="font-poppins antialiased">
    <a href="#main-content" data-pp-salto>Saltar al contenido</a>
    <!-- ======================= BANNER PAÍS (geo-detect) ======================= -->
    <GeoCountryBanner
      detectCountry={detectCountry}
      currentCountry="VE"
      otherSiteUrl="https://ni.peptidosplus.com"
      otherLabel="Nicaragua"
    />

    <Fragment set:html={cabecera} />

    <main id="main-content" class="pp-main-wrap">
      <slot />
    </main>

    <Fragment set:html={pie} />
    <Fragment set:html={flotante} />

    <!-- JS de comportamiento, el mismo de las páginas estáticas de public/ -->
    <script src="/behaviors.js" defer></script>
    <script src="/carrito.js" defer></script>
    <script src="/assets/datos/coas.js" defer></script>
    <script src="/certificados.js" defer></script>
    <script src="/assets/js/pp-sitio.js" defer></script>
    {import.meta.env.DEV && (
      <script is:inline src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    )}

    <!-- Re-captura los marcadores .reveal tras la hidratación de Astro:
         behaviors.js corre con defer antes de que el DOM astral se pinte,
         así que se re-observan los elementos que añade el template. -->
    <script is:inline>
      (function () {
        'use strict';
        var bringToLife = function () {
          var els = document.querySelectorAll('[data-reveal], .reveal, [class*="animate-fade"], [class*="animate-slide"]');
          if (!els.length || !('IntersectionObserver' in window)) return;
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (!e.isIntersecting) return;
              e.target.classList.add('is-visible');
              e.target.style.opacity = '';
              e.target.style.transform = '';
              io.unobserve(e.target);
            });
          }, { rootMargin: '0px 0px -10% 0px', threshold: 0.08 });
          els.forEach(function (el) { io.observe(el); });
        };
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', bringToLife);
        } else {
          bringToLife();
        }
        document.addEventListener('astro:page-load', bringToLife);
        document.addEventListener('astro:after-swap', bringToLife);
        window.addEventListener('resize', bringToLife);
      })();
    </script>
  </body>
</html>
