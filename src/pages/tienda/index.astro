---
/**
 * Catálogo / tienda — /tienda
 * Página canónica del catálogo: sirve public/store.html (diseño original)
 * con canonical /tienda. SSR on-demand (el Worker la renderiza).
 */
export const prerender = false;

const PUBLIC_HTML: Record<string, string> = import.meta.glob('../../../public/store.html', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

const key = Object.keys(PUBLIC_HTML).find((k) => k.endsWith('/store.html'));
const html = key ? (PUBLIC_HTML[key] as string) : null;
if (!html) return new Response('Not Found', { status: 404 });

const SITE_URL = 'https://ve.peptidosplus.com';
const canonical = `${SITE_URL}/tienda`;
let out = html;
if (/rel="canonical"/i.test(out)) {
  out = out.replace(/<link rel="canonical"[^>]*>/i, `<link rel="canonical" href="${canonical}" />`);
} else if (/<\/head>/i.test(out)) {
  out = out.replace(/<\/head>/i, `<link rel="canonical" href="${canonical}" />\n</head>`);
}

return new Response(out, {
  headers: { 'Content-Type': 'text/html; charset=utf-8' },
});
---
