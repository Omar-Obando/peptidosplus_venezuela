    )}

    <!-- Re-captura los marcadores .reveal tras la hidratación de Astro:
         behaviors.js corre con defer antes de que el DOM astral se pinte,
         así que se re-observan los elementos que añade el template. -->
    <script is:inline>
      (function () {
        'use strict';
        var bringToLife = function () {
          var els = document.querySelectorAll('[data-reveal], .reveal, [class*="animate-fade"], [class*="animate-slide"]');
          if (!els.length || !('IntersectionObserver' in window)) return;
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (!e.isIntersecting) return;
              e.target.classList.add('is-visible');
              e.target.style.opacity = '';
              e.target.style.transform = '';
              io.unobserve(e.target);
            });
          }, { rootMargin: '0px 0px -10% 0px', threshold: 0.08 });
          els.forEach(function (el) { io.observe(el); });
        };
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', bringToLife);
        } else {
          bringToLife();
        }
        document.addEventListener('astro:page-load', bringToLife);
        document.addEventListener('astro:after-swap', bringToLife);
        window.addEventListener('resize', bringToLife);
      })();
    </script>
  </body>
</html>
