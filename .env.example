# WooCommerce Configuration
# Copy this file to .env and fill in your values

# WordPress/WooCommerce Store URL (your WordPress site URL)
WP_API_URL=https://your-wordpress-site.com/wp-json
WC_API_URL=https://your-wordpress-site.com/wp-json

# PhantomWP Connect access secret
# Sent by server-side API routes as X-PhantomWP-Secret.
WP_ACCESS_SECRET=your_random_secret_string
WC_ACCESS_SECRET=your_random_secret_string

# JWT Secret for authentication
JWT_SECRET=your_jwt_secret_32_chars_minimum

# Stripe inline Payment Element (optional)
# Requires Woo Stripe enabled, provider keys configured, and this public flag set to true.
PUBLIC_PAYMENT_STRIPE_ENABLED=false
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal buttons (optional)
# Requires Woo PayPal enabled, provider keys configured, and this public flag set to true.
PUBLIC_PAYMENT_PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=your_paypal_client_id
PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# Public store display settings are committed in src/config/store.ts.
# Do not put API keys, payment secrets, or access tokens in that file.

# Site URL (for callbacks and sitemap)
PUBLIC_SITE_URL=https://your-site.com

# Cloudflare Turnstile (optional - bot protection for checkout and reviews)
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
