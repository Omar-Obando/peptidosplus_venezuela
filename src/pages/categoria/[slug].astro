---
/**
 * Category archive — /categoria/[slug] (SSR on-demand, diseño de marca).
 */
import BrandLayout from '@/layouts/BrandLayout.astro';
import { safeCategories, postTitle, postExcerpt, catName, esDate, readTime } from '@/lib/blog';
import { getCategoryBySlug, getPostsByCategory } from '@/lib/wordpress';
import { SITE } from '@/lib/site';

const { slug } = Astro.params;

if (!slug) return Astro.redirect('/404');

let category: any = null;
try { category = await getCategoryBySlug(slug); } catch { category = null; }

let posts: any[] = [];
try { posts = await getPostsByCategory(slug); } catch { posts = []; }

const allCategories = await safeCategories();
const others = allCategories.filter((c) => c.slug !== slug).slice(0, 8);

const title = category?.name || 'Categoría';
const description =
  category?.description || `Artículos y guías de la categoría ${title} en ${SITE.name}.`;
const canonicalUrl = `${SITE.url}/categoria/${slug}`;

const pageLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  url: canonicalUrl,
  description,
  isPartOf: { '@type': 'Blog', url: `${SITE.url}/blog` },
};
---

<BrandLayout title={title} description={description} canonicalUrl={canonicalUrl}>
  <slot name="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(pageLd)} />
  </slot>

  <div class="content-container pp-art-wrap py-12 md:py-16">
    <header class="pg-art-cab mb-10">
      <p class="pg-cejilla font-poppins">Categoría · {postTitle({ title: { rendered: title } } as any)}</p>
      <h1 class="pg-h1">{title}</h1>
      <p class="pg-sub">{description}</p>
    </header>

    {posts.length === 0 ? (
      <p class="pg-gris">Aún no hay artículos en esta categoría.</p>
    ) : (
      <div class="pg-lista">
        {posts.map((p) => (
          <a class="pg-entrada" href={`/blog/${p.slug}`} data-cat={catName(p)}>
            <span class="pg-entrada-meta"><b class="font-poppins">{catName(p)}</b><span>{esDate(p.date)} · {readTime(p)} min</span></span>
            <h3>{postTitle(p)}</h3>
            <p>{postExcerpt(p, 150)}</p>
          </a>
        ))}
      </div>
    )}

    {others.length > 0 && (
      <div class="pg-otras mt-10">
        <h3 class="font-poppins text-sm font-bold uppercase tracking-wide text-[var(--pp-tinta-3)] mb-3">Otras categorías</h3>
        <div class="flex flex-wrap gap-2">
          {others.map((c) => (
            <a key={c.slug} href={`/categoria/${c.slug}`} class="pg-tag">{c.name}</a>
          ))}
        </div>
      </div>
    )}
  </div>
</BrandLayout>
