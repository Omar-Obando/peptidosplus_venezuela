---
/**
 * Blog post detail — /blog/[slug] (SSR on-demand)
 * Diseño de marca: <article class="pg-art"> + pg-cejilla/pg-h1/pg-sub/pg-lista
 * (CSS compilado del sitio original ya servido por BrandLayout).
 */
import BrandLayout from '@/layouts/BrandLayout.astro';
import TableOfContents from '@/components/blog/TableOfContents.astro';
import {
  safePost,
  resolveAuthor,
  relatedPosts,
  postTitle,
  postExcerpt,
  postImage,
  firstCategory,
  catName,
  esDate,
  readTime,
} from '@/lib/blog';
import {
  addHeadingIds,
  rewriteContentUrls,
  extractHeadings,
  calculateReadingTime,
  seoDescription,
  sanitizePostContent,
  applyExternalLinkPolicy,
} from '@/lib/seo';
import { SITE } from '@/lib/site';
import { getPostTags } from '@/lib/wordpress';

const { slug } = Astro.params;

if (!slug) return Astro.redirect('/404');

const post = await safePost(slug);
if (!post) return Astro.redirect('/404');

const title = postTitle(post);
const description = seoDescription(post, postExcerpt(post, 160));
const canonicalUrl = `${SITE.url}/blog/${slug}`;

const author = await resolveAuthor(post);
const tags = getPostTags(post) || [];
const cat = firstCategory(post);
const featuredImage = postImage(post) || '';

const bodyHtml = applyExternalLinkPolicy(
  addHeadingIds(rewriteContentUrls(sanitizePostContent(post?.content?.rendered || '')))
);
const headings = extractHeadings(bodyHtml);
const readingTime = calculateReadingTime(post?.content?.rendered || '');
const related = await relatedPosts(post, 3);

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog` },
    ...(cat ? [{ '@type': 'ListItem', position: 3, name: catName(post), item: `${SITE.url}/categoria/${cat.slug}` }] : []),
    { '@type': 'ListItem', position: cat ? 4 : 3, name: title, item: canonicalUrl },
  ],
};
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  ...(featuredImage ? { image: featuredImage } : {}),
  author: { '@type': 'Person', name: author?.name || SITE.name },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  datePublished: post.date,
  dateModified: post.modified || post.date,
  mainEntityOfPage: canonicalUrl,
};
---

<BrandLayout
  title={title}
  description={description}
  image={featuredImage || undefined}
  canonicalUrl={canonicalUrl}
>
  <slot name="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(articleLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
  </slot>

  <div class="content-container pp-art-wrap">
    <article class="pg-art">
      <header class="pg-art-cab">
        <p class="pg-cejilla font-poppins">
          {cat ? catName(post) : 'Blog'} · {esDate(post.date)} · {readingTime} min
        </p>
        <h1 class="pg-h1">{title}</h1>
        <p class="pg-sub">{description}</p>
        <p class="pg-gris">{author?.name || 'Equipo Peptidos Plus'} · Solo para investigación</p>
      </header>

      {headings.length > 0 && <TableOfContents headings={headings} readingTime={readingTime} />}

      <div set:html={bodyHtml} />

      {tags.length > 0 && (
        <div class="pg-tags">
          {tags.map((t: any) => (
            <a key={t.id} href={`/tag/${t.slug}`} class="pg-tag">{t.name}</a>
          ))}
        </div>
      )}

      <div class="pg-autor">
        {author?.avatar_urls?.['96'] ? (
          <img src={author.avatar_urls['96']} alt={author.name} class="pg-autor-avatar" />
        ) : (
          <span class="pg-autor-inicial">{author?.name?.charAt(0) || 'P'}</span>
        )}
        <div>
          <small>Escrito por</small>
          <b>{author?.name || SITE.name}</b>
        </div>
      </div>

      <p class="pg-aviso">Contenido educativo basado en literatura publicada. Los productos de Peptidos Plus se destinan exclusivamente a investigación; nada de lo anterior es consejo médico.</p>

      {related.length > 0 && (
        <section class="pg-rel">
          <p class="pg-cejilla font-poppins">Relacionados · {cat ? catName(post) : 'Blog'}</p>
          <div class="pg-lista">
            {related.map((r) => (
              <a class="pg-entrada" href={`/blog/${r.slug}`} data-cat={catName(r)}>
                <span class="pg-entrada-meta"><b class="font-poppins">{catName(r)}</b><span>{esDate(r.date)} · {readTime(r)} min</span></span>
                <h3>{postTitle(r)}</h3>
                <p>{postExcerpt(r, 140)}</p>
              </a>
            ))}
          </div>
        </section>
      )}

      <p class="pg-volver"><a href="/blog">← Todos los artículos</a></p>
    </article>
  </div>
</BrandLayout>
