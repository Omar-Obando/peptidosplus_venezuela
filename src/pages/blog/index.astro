---
/**
 * Blog index — /blog (diseño de marca: pg-entrada / pg-lista del sitio original,
 * datos del CMS headless).
 */
import BrandLayout from '@/layouts/BrandLayout.astro';
import { safePosts, safeCategories, postTitle, postExcerpt, postImage, catName, esDate, readTime } from '@/lib/blog';
import { SITE } from '@/lib/site';

const posts = await safePosts(100);
const categories = await safeCategories();

const title = 'Artículos y revisiones — Peptidos Plus';
const description =
  'Artículos, guías y análisis sobre péptidos research grade para investigación: mecanismos, certificados de análisis, reconstitución y más.';
const canonicalUrl = `${SITE.url}/blog`;

const blogLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `Blog ${SITE.name}`,
  url: canonicalUrl,
  description,
  blogPost: posts.slice(0, 10).map((p) => ({
    '@type': 'BlogPosting',
    headline: postTitle(p),
    url: `${SITE.url}/blog/${p.slug}`,
    datePublished: p.date,
    image: postImage(p) || undefined,
  })),
};
const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Últimos artículos',
  itemListElement: posts.slice(0, 20).map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${SITE.url}/blog/${p.slug}`,
    name: postTitle(p),
  })),
};
---

<BrandLayout title={title} rawTitle={title} description={description} canonicalUrl={canonicalUrl}>
  <slot name="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(blogLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(itemListLd)} />
  </slot>

  <div class="content-container pp-art-wrap py-12 md:py-16">
    <header class="pg-art-cab mb-10 reveal">
      <p class="pg-cejilla font-poppins">Blog · Peptidos Plus</p>
      <h1 class="pg-h1">Artículos y revisiones</h1>
      <p class="pg-sub">{description}</p>
    </header>

    {posts.length === 0 ? (
      <p class="pg-gris">Aún no hay artículos publicados. Vuelve pronto.</p>
    ) : (
      <div class="pg-lista">
        {posts.map((p) => (
          <a class="pg-entrada" href={`/blog/${p.slug}`} data-cat={catName(p)}>
            <span class="pg-entrada-meta"><b class="font-poppins">{catName(p)}</b><span>{esDate(p.date)} · {readTime(p)} min</span></span>
            <h3>{postTitle(p)}</h3>
            <p>{postExcerpt(p, 150)}</p>
          </a>
        ))}
      </div>
    )}
  </div>
</BrandLayout>
