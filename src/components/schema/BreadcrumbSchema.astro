---
/**
 * Breadcrumb Schema (JSON-LD)
 *
 * Renders https://schema.org/BreadcrumbList from a flat array of
 * `{ name, path }` items (paths may be relative or absolute).
 */
interface Props {
  breadcrumbs: Array<{ name: string; path: string }>;
}

const { breadcrumbs = [] } = Astro.props;
const base = Astro.site || 'https://ve.peptidosplus.com';
const url = (path: string) => (path.startsWith('http') ? path : new URL(path, base).href);

const itemListElement = breadcrumbs.map((item, i) => ({
  '@type': 'ListItem',
  position: i + 1,
  name: item.name,
  item: url(item.path),
}));

const data = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement,
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />
